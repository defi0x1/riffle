# Copy to .env.local for local development (Vite loads .env.local automatically, and it is
# gitignored). Neither variable is secret -- both are public endpoints the browser calls directly.

# Base URL of the backend API described in README.md's HTTP contract section.
VITE_API_BASE_URL=http://localhost:8787

# Solana RPC endpoint this app uses for its own independent simulation and submission checks --
# deliberately configurable separately from whatever RPC the backend uses, so the two never
# share a single point of failure (see src/solana/connection.ts). Use a reputable provider, not
# a shared public endpoint, for anything beyond local devnet testing.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
