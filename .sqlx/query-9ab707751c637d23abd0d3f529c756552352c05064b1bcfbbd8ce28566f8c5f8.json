  "query": "\n        SELECT p.pool_address, p.venue, p.token_x, p.token_y, d.bin_step, p.tier_changed_at\n        FROM pools p\n        JOIN dlmm_pool_params d ON d.pool_address = p.pool_address\n        WHERE p.tier = $1\n        ORDER BY p.pool_address\n        ",
