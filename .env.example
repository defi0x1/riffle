# Copy to .env and fill in. Real values are never committed (.env is gitignored).

# Postgres connection string. Matches the defaults in compose.yaml.
DATABASE_URL=postgres://feefarm:feefarm@localhost:5432/feefarm

# Solana RPC endpoint used by the rpc source backend and any getMultipleAccounts polling.
RPC_URL=https://rpc.example.com/YOUR_API_KEY

# Geyser gRPC endpoint and auth token, used by the geyser source backend. Leave unset
# if running on backend: rpc only.
GEYSER_ENDPOINT=https://geyser.example.com:10000
GEYSER_TOKEN=changeme-geyser-token

# Telegram bot credentials. Token from @BotFather; allowed chats is a comma-separated
# allowlist of chat IDs the bot will respond in.
TELEGRAM_BOT_TOKEN=000000000:AAExampleExampleExampleExampleExampleExx
TELEGRAM_ALLOWED_CHATS=123456789,-987654321

# Public Jupiter price API, used for USD pricing where a pool's own tokens are illiquid.
JUPITER_PRICE_URL=https://price.jup.ag/v6

# tracing subscriber filter, e.g. info, debug, indexer=debug,source=info.
LOG_LEVEL=info

# tracing output format: pretty for local dev, json for shipped logs.
LOG_FORMAT=pretty
